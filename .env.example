# Fastmail API token: Settings > Privacy & Security > Integrations > API tokens
# Needs Email (read/write) scope.
FASTMAIL_API_TOKEN=

# Ollama host. Local default, or https://ollama.com with OLLAMA_API_KEY.
OLLAMA_HOST=http://localhost:11434
OLLAMA_API_KEY=

# clef (local), clef:cloud (local Ollama signed in), or clef-flash
CLEF_MODEL=clef
