{
  "name": "fastmail-triage",
  "version": "0.1.0",
  "description": "Triage Fastmail email with Ollama's Clef decision model: typed questions in, mail actions out.",
  "type": "module",
  "private": true,
  "scripts": {
    "triage": "node --env-file-if-exists=.env --import tsx src/index.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "license": "MIT",
  "packageManager": "pnpm@10.6.4",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
